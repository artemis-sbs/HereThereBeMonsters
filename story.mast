--- scene_distress_call_three
    here_scene("DISTRESS CALL", "The Odessa has gone silent", artemis_id)
############################
    # create the 
    #x="20000.0" y="10.0" z="50000.0"
    odessa_sd = npc_spawn(*Vec3.from2x_coord(20_000, -200, 50_000), "Distress Call", "civ", "unknown", "behav_do_nothing")
    shared odessa_id = to_id(odessa_sd)
    odessa_obj = to_object(odessa_sd)
    set_face(odessa_id, odessa_face)
    link(artemis_id, "extra_scan_source", odessa_id)
    #
    # Make it spin and blink
    #
    odessa_obj.engine_object.steer_yaw =  0.003
    odessa_obj.engine_object.steer_pitch = -0.002
    odessa_obj.engine_object.steer_roll =  0.001
    odessa_obj.engine_object.blink_state = -5
    #odessa_sd.blob.set("local_scale_coeff", 3.0,0)
    #
    # This has some candy
    #
    #<create type="Anomaly" pickupType="2" x="21000.0" y="10.0" z="50000.0"/>
    #<create type="Anomaly" pickupType="0" x="19000.0" y="-50.0" z="50000.0"/>
    pickup_spawn(*Vec3.from2x_coord(21000.0, 10.0, 50000.0), "cetrocite_crystal")
    pickup_spawn(*Vec3.from2x_coord(19000.0, -50.0, 50000.0), "hidens_powercell")
    #
    message = "Incoming Distress Signal. Check with captain to view on main screen"
    choice = here_comms_incoming_info_message(message, artemis_id, dauntless_id, title="Distress Call", button="Accept Message", time=12)

# Wait for button press
    pressed = await choice

# Message from Odessa
    message = """This is the Terran Science Vessel "Odessa".  We are under attack from an Unknown vessel... Engines...Boarding... Please Help!....."""
    here_receive_info_message(message, artemis_id, odessa_id, title="Distress Call", time=14, audio="audio/SD02C0165")

    await delay_sim(14)
    here_info_panel_clear_comms()

    
## Loop until close to odessa
    await distance_less(artemis_id, odessa_id, 6000)

    odessa = to_object(odessa_id)
    if odessa is not None:
        odessa.name = "Odessa"
        odessa.art_id = "science_ship"


    message = "We scanned the ship and were are able to salvage a recording from the wreckage"
    choice = here_comms_incoming_info_message(message, artemis_id, ensign_rachel, title="Scan report", button="Recover Odessa Science Log", time=12)

    pressed = await choice

    message = """Science officer's log 76.2. This sector of space has an unusually high concentration of stellar creatures. It is an ideal place to study their behaviors in more details.  The Piranhas in this sector have been exhibiting aggressive behavior.  More so than has ever been reported. I think this might be a breeding ground. There is not much known about the breeding habits of these piranhas. This is an excellent opportunity for research but I still need to convince the captain to let us take a closer look.   The last run in left our long range communication array slightly chewed."""
    here_receive_info_message(message, artemis_id, dauntless_id, title="Log playback", time=35, audio="audio/SD02C0164")
    await delay_sim(35)
    here_info_panel_clear_comms()


    message = """Contact TSN Command about Odessa sceince log."""
    choice = here_comms_incoming_info_message(message, artemis_id, ensign_rachel, title="Update on Odessa", button="Contact TSN Command", time=12)
    
    pressed = await choice
    here_info_panel_clear_comms()

    with comms_override(ensign_rachel, tsn_command):
        comms_transmit("Piranhas are a fearsome creature. But it doesn't look like Piranhas doomed the Odessa. Find out whats happening to these ships.", "Keep searching")

    await delay_sim(100)


--- scene_web_trap
    here_scene("ENSNARED", "Something has us", artemis_id)
    # create the 
    # x="22000.0" y="0.0" z="25000.0"
    # web_generator_sd = npc_spawn(*Vec3.from2x_coord(22_000, 0, 25_000), "Distress Call", "civ", "unknown", "behav_do_nothing")
    # shared web_generator_id = to_id(web_generator_sd)
    # web_generator_obj = to_object(web_generator_sd)
    # set_face(web_generator_id, web_generator_face)
    # link(artemis_id, "extra_scan_source", web_generator_id)
    
# Disable Warp drive
    obj = to_object(artemis_id)
    obj.data_set.set("warp_drive_active",0,0)

    await delay_sim(20)

    message = "It's a Web Generator!! You cannot travel at warp near it but impulse power should be unaffected. Sceince or engineering need to acknoledge."
    choice = here_comms_incoming_info_message(message, artemis_id, ensign_rachel, title="Ensign Rachel Reporting:", button="Acknowledge", time=0, consoles="science, engineering")
# Awaits for the button press or the time out
    pressed = await promise_any(choice, delay_sim(10))
    here_info_panel_clear_comms("science,engineering")

    await delay_sim(20)

    message = "Incoming Distress Signal. Check with captain to view on main screen"
    choice = here_comms_incoming_info_message(message, artemis_id, ensign_rachel, title="Distress Call", button="Accept Message", time=12)

    pressed = await choice

    message = """Look who has stumbled into my little trap I'll be there soon to help you out"""
    here_receive_info_message(message, artemis_id, wolf_spider, title="Help Response", time=13, audio="audio/SD01C0110")
    await delay_sim(13)
    here_info_panel_clear_comms()

    await delay_sim(180)



--- scene_hostage_message
    here_scene("HOSTAGES", "They are not alone out here", artemis_id)
    # create the 
    # x="50000.0" y="15000.0" z="30000.0"
    hostage_station_sd = npc_spawn(*Vec3.from2x_coord(50_000, 1000, 30_000), "Distress Call", "civ", "unknown", "behav_do_nothing")
    shared hostage_station_id = to_id(hostage_station_sd)
    hostage_station_obj = to_object(hostage_station_sd)
    #set_face(web_generator_id, web_generator_face)
    

    message = "Incoming Distress Signal. Check with captain to view on main screen"
    choice = here_comms_incoming_info_message(message, artemis_id, ensign_rachel, title="Distress Call", button="Accept Message", time=12)

    pressed = await choice

    message = """Is there anyone out there? Help us they have us trapped here waiting for ransom.  And if no one pays we will be forced to work in the mines."""
    here_receive_info_message(message, artemis_id, ensign_rachel, title="Help Response", time=13, audio="audio/A0001")
    await delay_sim(13)
    here_info_panel_clear_comms()

    await delay_sim(23)

    message = """We should notiify TSN command about this situation."""
    choice = here_comms_incoming_info_message(message, artemis_id, ensign_rachel, title="Hostage situation", button="Contact TSN Command", time=12)
    
    pressed = await choice
    here_info_panel_clear_comms()

    with comms_override(ensign_rachel, tsn_command):
        comms_transmit("A hostage situation! It is imperative that you rescue those hostages. Find where the hostages are located and launch marines to retrieve them.", "Rescue Hostages")

    link(artemis_id, "extra_scan_source", hostage_station_id)

    hostage_station_obj = to_object(hostage_station_sd)
    hostage_station_obj.art_id = "starbase_science"

