#######################################
# === scene_mission_briefing_start
#######################################    
    
--- need_comms_console

## Wait for a comms console to be around
    await delay_sim(5)
    cc = gui_console_clients("comms")
    jump need_comms_console if len(cc)==0
    await delay_sim(10)

--- send_comms_console_message

    cc = gui_console_clients("comms")
    jump send_comms_console_message if len(cc)==0

#######################################
#--- mission_briefing_message
#######################################

# ONE hail, where there used to be a notification, an await, and a message. The
# "Incoming message" card existed only to say a message had arrived - the Incoming
# Hails list says that now - and the button that acknowledged it is the hail's answer.
# `await` blocks the story here exactly as `await choice` did.
    await hail_ask(artemis_id, scene="mission_briefing", speaker="tsn_command")


##########################################################################################
# Distress Call One

# delay until the next scene
    await delay_sim(60)
#######################################
--- scene_distress_call_one
#######################################
    here_scene("DISTRESS CALL", "An Arvonian liner is under attack", artemis_id)
    whale_watcher_sd = to_id(npc_spawn(*Vec3.from2x_coord(90_000, 10, 60_000), whale_watcher_name, "arvonian", "unknown", "behav_do_nothing"))
    shared whale_watcher_id = to_id(whale_watcher_sd)
    ww_obj = to_object(whale_watcher_sd)
    set_face(whale_watcher_id, whale_watcher_face)
    #
    # Make it spin and blink
    #

    ww_obj.engine_object.steer_yaw =  0.003
    ww_obj.engine_object.steer_pitch = -0.002
    ww_obj.engine_object.steer_roll =  0.001
    ww_obj.engine_object.blink_state = -5
# Let us see it? Or should science see it
    


    await hail_ask(artemis_id, scene="whale_watcher_distress", speaker="whale_watcher", subject=whale_watcher_id)

    link(artemis_id,"extra_scan_source" ,whale_watcher_id)

    
#######################################
# --- approach_whale_watcher
#######################################
    await distance_less(artemis_id, whale_watcher_id, 6000)

    whale_watcher_name = "Whale Watcher 1"
    ww = to_object(whale_watcher_id)
    if ww is not None:
        ww.name = whale_watcher_name
        ww.art_id = "luxury_liner"
# Keep waiting until artemis is close to the luxury liner    
    #jump approach if d > 6000
# It is now close enough
--- salvage
    here_scene("SALVAGE", "Recovering the captains log", artemis_id)
# Engin Rachel reports recovery
    await hail_ask(artemis_id, scene="salvage_report", speaker="ensign_rachel")
#######################################
#--- retrieve_recording
#######################################
--- shuttle
    await hail_ask(artemis_id, scene="whale_watcher_log", speaker="whale_watcher")
    
    await delay_sim(13)


    #<create type="genericMesh" x="90000.0" y="0.0" z="61000.0" name="Damaged Shuttle" meshFileName="dat\TSNShuttle.dxs" textureFileName="dat\LightCruiser_Diffuse.png"/>
    shared damaged_shuttle_id = to_id(npc_spawn(*Vec3.from2x_coord(90000.0,0.0,61000.0), "Damaged Shuttle", "arvonian", "tsn_shuttle", "npc_no_nothing"))
    

    await delay_sim(10)
    await hail_ask(artemis_id, scene="shuttle_located", speaker="ensign_rachel")

    message = "Artemis to TSN Command, we are sending you the Whale Watcher Log. We have also discovered a shuttle with one life sign. Please Advise."
    with comms_override(artemis_id,tsn_command):
        comms_transmit(message, "Update on shuttle")

    await delay_sim(10)

    message = "Such a shame Tourism is very risky in this sector of space. Retrieve the shuttle and check for Survivors."
    with comms_override(artemis_id, tsn_command):
        comms_receive(message, "Orders")



#######################################
#--- retrieve_shuttle
#######################################

    d = 2000
## scene_pick up shuttle
## This should maybe be enhanced to have Weapons tractor beam the shuttle
### That would be a cool element
# Wait for artemis to get close to the shuttle
    for x while d > 1000:
        await delay_sim(4)
        if to_object(artemis_id) is None or to_object(damaged_shuttle_id) is None:
            # Probably signal end of game
            ->END

        d = sbs.distance_id(artemis_id, damaged_shuttle_id)

# OK now the shuttle is close, take it off the board
    shuttle = to_object(damaged_shuttle_id)
    if shuttle is not None:
        shuttle.delete_object()

# Show medical bay update        
    await delay_sim(10)
#############################    
--- medical_bay_update_one
#############################
# This goes to just comms
# medical bay update 1
    await hail_ask(artemis_id, scene="survivor_recovered", speaker="medical_bay")

    await delay_sim(13)

    await hail_ask(artemis_id, scene="report_survivor", speaker="ensign_rachel")

    message = "Artemis to TSN Command, We have recovered one life form alive and they are in our medical bay receiving treatment."
    with comms_override(artemis_id, tsn_command):
        comms_transmit(message, "Update on Lifeform.")


    await delay_sim(10)
# TSN Update survivor
    message = "Good Work. At least we saved one poor soul. Keep a look out try and find out what happen. "
    with comms_override(artemis_id, tsn_command):
        comms_receive(message, "Response on Lifeform")

# AND.....SCENE
# RUN the saboteur side quest
    task_schedule(side_quest_saboteur)

    await delay_sim(200)
##########################################################################################
# Distress Call Two
############################
--- scene_distress_call_two
    here_scene("DISTRESS CALL", "TSN Dauntless", artemis_id)
############################
    # create the 
    #x="48000.0" y="10.0" z="70000.0"
    dauntless_sd = npc_spawn(*Vec3.from2x_coord(48_000, 10, 70_000), "Unknown Ship", "civ", "unknown", "behav_do_nothing")
    shared dauntless_id = to_id(dauntless_sd)
    dauntless_obj = to_object(dauntless_sd)
    set_face(dauntless_id, dauntless_face)
    link(artemis_id, "extra_scan_source", dauntless_id)
    #
    # Make it spin and blink
    #
    dauntless_obj.engine_object.steer_yaw =  0.003
    dauntless_obj.engine_object.steer_pitch = -0.002
    dauntless_obj.engine_object.steer_roll =  0.001
    dauntless_obj.engine_object.blink_state = -5
    #
    # This has some candy
    #
    pickup_spawn(*Vec3.from2x_coord(47000.0, 50.0, 70000.0), "cetrocite_crystal")
    pickup_spawn(*Vec3.from2x_coord(47000.0, -50.0, 70000.0), "hidens_powercell")
    #



    await hail_ask(artemis_id, scene="dauntless_distress", speaker="dauntless", subject=dauntless_id)

    
## Loop until close to dauntless
    await distance_less(artemis_id, dauntless_id, 6000)

    daunt = to_object(dauntless_id)
    if daunt is not None:
        daunt.name = "Dauntless"
        daunt.art_id = "cargo_ship"


## Maybe enhancement that weapons or science needs to scan

    await delay_sim(5)

    await hail_ask(artemis_id, scene="dauntless_scan", speaker="ensign_rachel")

    await hail_ask(artemis_id, scene="dauntless_log", speaker="dauntless")

--- strange_object
    here_scene("UNKNOWN CONTACT", "Sensors cannot classify it", artemis_id)
    # x="48500.0" y="150.0" z="69500.0"
    strange_object_sd = npc_spawn(*Vec3.from2x_coord(48_500, 150, 69_500), "Strange Object", None, "alien_small_3b", "behav_do_nothing")
    shared strange_object_id = to_id(strange_object_sd)
    strange_object_obj = to_object(strange_object_sd)
    #
    # Make it spin and blink
    #
    strange_object_obj.engine_object.steer_yaw =  0.003
    strange_object_obj.engine_object.steer_pitch = -0.002
    strange_object_obj.engine_object.steer_roll =  0.001
    strange_object_obj.engine_object.blink_state = -3

# No button on the old card, so no answer here either - a one-way report. The hail
# offers its own Close, and the story does not wait for it.
    hail_offer(artemis_id, scene="strange_object_sighted", speaker="ensign_rachel")
    await delay_sim(12)

## Loop until close to strange object
    await distance_less(artemis_id, strange_object_id, 1000)

#
# TODO: Tractor beam by weapons
#       Science needs to scan it?
#

# OK now the shuttle is close, take it off the board
    strange = to_object(strange_object_id)
    if strange is not None:
        strange.delete_object()

--- strange_object_finish
    await hail_ask(artemis_id, scene="web_generator", speaker="ensign_rachel")

    with comms_override(ensign_rachel, tsn_command):
        comms_transmit("This Beacon is some sort of Warp field disruptor. We call it a Web Generator. You cannot travel at warp near it but impulse power should be unaffected", "Important discovery")


##########################################################################################
# Distress Call Three
############################
--- scene_distress_call_three
    here_scene("DISTRESS CALL", "The Odessa has gone silent", artemis_id)
############################
    # create the 
    #x="20000.0" y="10.0" z="50000.0"
    odessa_sd = npc_spawn(*Vec3.from2x_coord(20_000, -200, 50_000), "Distress Call", "civ", "unknown", "behav_do_nothing")
    shared odessa_id = to_id(odessa_sd)
    odessa_obj = to_object(odessa_sd)
    set_face(odessa_id, odessa_face)
    link(artemis_id, "extra_scan_source", odessa_id)
    #
    # Make it spin and blink
    #
    odessa_obj.engine_object.steer_yaw =  0.003
    odessa_obj.engine_object.steer_pitch = -0.002
    odessa_obj.engine_object.steer_roll =  0.001
    odessa_obj.engine_object.blink_state = -5
    #odessa_sd.blob.set("local_scale_coeff", 3.0,0)
    #
    # This has some candy
    #
    #<create type="Anomaly" pickupType="2" x="21000.0" y="10.0" z="50000.0"/>
    #<create type="Anomaly" pickupType="0" x="19000.0" y="-50.0" z="50000.0"/>
    pickup_spawn(*Vec3.from2x_coord(21000.0, 10.0, 50000.0), "cetrocite_crystal")
    pickup_spawn(*Vec3.from2x_coord(19000.0, -50.0, 50000.0), "hidens_powercell")
    #
# Message from Odessa
    await hail_ask(artemis_id, scene="odessa_distress", speaker="odessa", subject=odessa_id)

    
## Loop until close to odessa
    await distance_less(artemis_id, odessa_id, 6000)

    odessa = to_object(odessa_id)
    if odessa is not None:
        odessa.name = "Odessa"
        odessa.art_id = "science_ship"


    await hail_ask(artemis_id, scene="odessa_scan", speaker="ensign_rachel")

    await hail_ask(artemis_id, scene="odessa_log", speaker="odessa")


    await hail_ask(artemis_id, scene="report_odessa", speaker="ensign_rachel")

    with comms_override(ensign_rachel, tsn_command):
        comms_transmit("Piranhas are a fearsome creature. But it doesn't look like Piranhas doomed the Odessa. Find out whats happening to these ships.", "Keep searching")

    await delay_sim(100)


