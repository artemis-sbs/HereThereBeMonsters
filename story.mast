    consoles = linked_to(artemis_id, "consoles")
    comms_info_card(consoles, "message one", time=5)


    sick_bay = list(grid_objects(artemis_id) & role("sickbay"))
    warp = list(grid_objects(artemis_id) & role("warp"))
    sick_bay = sick_bay[0]
    warp_id = warp[0]

    t = grid_pos_data(sick_bay)
    x = t[0]
    y = t[1]

    sab = grid_spawn(artemis_id, "?", "SABT", x, y, 119, "red", "#")

    grid_target(sab, warp_id)
    
    p = await grid_arrive_id(sab, warp_id) 
    print(f" Got there {p}")
